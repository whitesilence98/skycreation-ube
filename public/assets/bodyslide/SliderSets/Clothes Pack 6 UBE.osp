    <SliderSet name="Clothes Pack 6 Shirt V4 UBE">
        <DataFolder>Clothes Pack 6 UBE</DataFolder>
        <SourceFile>Clothes Pack 6 Shirt V4 UBE.nif</SourceFile>
        <OutputPath>meshes\!UBE\doneb14n stuff\clothes pack 6\shirt</OutputPath>
        <OutputFile GenWeights="true">cp6_doneb14n shirt v4</OutputFile>
        <Shape target="BaseShape" DataFolder="UBE SE 2.0 Release Body">BaseShape</Shape>
        <Shape target="corset">corset</Shape>
