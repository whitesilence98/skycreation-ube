{
  "name": "cc-kit-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sync": "npm run sync:assets && npm run sync:index && npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sync:assets": "python -I scripts/sync_mo2_assets.py",
    "sync:part": "python scripts/sync_part.py",
    "sync:clothing": "python scripts/sync_part.py clothing",
    "sync:hair": "python scripts/sync_part.py hair",
    "sync:presets": "python scripts/sync_part.py presets",
    "sync:body": "python scripts/sync_part.py body",
    "sync:skin": "python scripts/sync_part.py skin",
    "sync:eyes": "python scripts/sync_part.py eyes",
    "sync:lashes": "python scripts/sync_part.py lashes",
    "sync:brows": "python scripts/sync_part.py brows",
    "sync:mouth": "python scripts/sync_part.py mouth",
    "sync:skeleton": "python scripts/sync_part.py skeleton",
    "sync:overlays": "python scripts/sync_part.py overlays",
    "sync:skins": "python -I scripts/sync_pack_skins.py",
    "sync:index": "python -I scripts/index_mo2_assets.py",
    "check:mo2": "python -I scripts/check_mo2_contract.py",
    "check:pack": "python -I scripts/check_pack_contract.py && node scripts/check_pack_server.cjs",
    "check:skin": "python -I scripts/check_skin_assets.py",
    "check:selection": "node scripts/check_asset_selection.cjs && node scripts/check_pack_selection.cjs",
    "check:face": "node scripts/check_face_panels.cjs",
    "check:neck": "node scripts/verify_neck_seam_3d.cjs",
    "check:skeleton": "node scripts/check_skeleton_hierarchy.cjs",
    "check:retarget": "node scripts/check_retarget.cjs",
    "check:jslot": "node scripts/check_dynamic_jslot_import.cjs",
    "check:nif": "node scripts/check_nif_import.cjs",
    "check:equip": "node scripts/check_equipment_thumbnails.cjs",
    "check:hair": "node scripts/check_hair_thumbnails.cjs",
    "check:hdr": "node scripts/check_hdr.cjs",
    "check:editor": "node scripts/check_editor_shell.cjs",
    "check:editor:screens": "node scripts/check_editor_browser.cjs",
    "check:deform": "node scripts/check_anatomy_deformation.cjs",
    "check:anatomy": "node scripts/check_anatomy_params.cjs",
    "check:brows": "node scripts/verify_brows_panel.cjs && node scripts/check_brow_rendering.cjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "next": "16.4.6",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
